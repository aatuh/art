float referenceLand(vec2 uv) {
    vec2 texel = vec2(0.45 / 128.0, 0.45 / 64.0);
    float center = referenceLandRaw(uv);
    float corners = referenceLandRaw(uv + vec2(texel.x, texel.y))
        + referenceLandRaw(uv + vec2(-texel.x, texel.y))
        + referenceLandRaw(uv + vec2(texel.x, -texel.y))
        + referenceLandRaw(uv - texel);
    return smoothstep(0.18, 0.82, (center * 2.0 + corners) / 6.0);
}
